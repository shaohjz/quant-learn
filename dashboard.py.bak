    <tr><th>日期</th><th>方向</th><th>股票</th><th>数量</th><th>价格</th><th>金额</th><th>来源</th><th>信号</th></tr>
    {% for t in trades %}
    <tr>
      <td>{{ t.trade_date }}</td>
      <td class="{{ 'buy' if t.direction == 'BUY' else 'sell' }}">
        {{ '🟢买' if t.direction == 'BUY' else '🔴卖' }}
      </td>
      <td>{{ t.stock_name }}({{ t.stock_code }})</td>
