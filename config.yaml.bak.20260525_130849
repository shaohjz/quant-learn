# ========== 风控（学习账户用） ==========
risk:
  max_position_pct: 0.60        # 单只股票最大仓位
  max_daily_trades: 5           # 每日最大交易笔数
  stop_loss_pct: -0.08          # 止损线
  take_profit_pct: 0.15         # 止盈线


# ========== 费用模型 ==========
fees:
  commission_rate: 0.00025      # 佣金万 2.5（现行国金 mini-QMT 默认）
  min_commission: 5.0           # 最低佣金 5 元
  stamp_tax_rate: 0.0005        # 印花税千 0.5（2023.8 起减半，现行）
  unit_size: 100                # 交易单位（A 股 100 股）


# ========== 推送通知 ==========
notifier:
  enabled: true
  # webhook URL 写到 config.local.yaml 不入库


# ========== 交易模式 ==========
broker:
  mode: "sim"                   # sim / live
  sim:
    slippage: 0.0               # 模拟盘滑点
  live:
    # qmt_path / qmt_account 通过环境变量 QMT_USERDATA_MINI / QMT_ACCOUNT_ID 注入
    session_id: 123456


# ========== 旧字段兼容（逐步淘汰） ==========
# 兼容老脚本读取 account.initial_cash / account.account_id
account:
  initial_cash: 100000          # = accounts.learn.initial_cash
  account_id: 1                 # = accounts.learn.account_id

# 兼容老脚本读取 stock_pool（已废弃，统一从 real_portfolio_rules + watchlist 读）
stock_pool: []
